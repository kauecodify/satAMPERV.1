# satAMPERV.1 API Gateway - Multi-stage Dockerfile
# Builds a production-ready Go API service

# Build stage
FROM golang:1.21-alpine AS builder

# Install dependencies
RUN apk add --no-cache git ca-certificates

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -o /satamperv-api -ldflags="-w -s" ./cmd/api

# Production stage
FROM alpine:3.18

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN adduser -D -u 1000 satamperv

# Copy binary from builder
COPY --from=builder --chown=satamperv:satamperv /satamperv-api /usr/local/bin/

# Copy configuration
COPY --chown=satamperv:satamperv config.yaml /etc/satamperv/

# Set working directory
WORKDIR /usr/local/bin

# Switch to non-root user
USER satamperv

# Expose ports
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Entrypoint
ENTRYPOINT ["/usr/local/bin/satamperv-api"]
CMD ["serve"]
